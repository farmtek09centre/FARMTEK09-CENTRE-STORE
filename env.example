# Copy this file to .env and fill in your real values.
# .env should NOT be committed to GitHub (see .gitignore).

PORT=5000

# Comma-separated list of front-end origins allowed to call this API.
# Add your GitHub Pages URL once deployed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,https://kabete2349.github.io

# ---- Business details (printed on every receipt) ----
BUSINESS_NAME=FARMTEK09 CENTRE
BUSINESS_PIN=
BUSINESS_ADDRESS=Lower Kabete, Nairobi
BUSINESS_PHONE=0725528888

# ---- KRA eTIMS (OSCU) ----
# Leave ETIMS_ENABLED=false until you have completed BOTH of these:
#   1. Registered FARMTEK09 CENTRE for eTIMS on iTax / the eTIMS portal
#      and been issued a TIN and branch ID (bhfId).
#   2. Submitted an OSCU "equipment use" application choosing a device
#      serial number (dvcSrlNo — any identifier you pick, e.g. a name
#      for this website) and had KRA approve it.
# With ETIMS_ENABLED=false, checkout still works — receipts are just
# marked as not yet KRA-registered instead of being submitted.
ETIMS_ENABLED=false
ETIMS_ENV=sandbox
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_DVC_SRL_NO=FARMTEK09WEB01
